NODE_ENV=development
PORT=8080
APP_VERSION=dev
GEMINI_API_KEY=
# A text model id from your AI Studio model list (…-flash or …-flash-lite; NOT -tts, -image or -preview)
GEMINI_MODEL=gemini-3.6-flash
# Optional: backup model ids, comma-separated, tried in order when the main one is overloaded (503) or out of quota (429)
GEMINI_FALLBACK_MODEL=
OPENAQ_API_KEY=
# Optional: key with ONLY the Air Quality API enabled. Empty = use Open-Meteo for forecasts.
GOOGLE_MAPS_API_KEY=
FORECAST_PROVIDER=google            # google | openmeteo
# Optional Delhi-NCR banner, copied by hand from the latest CAQM order
GRAP_STAGE=
GRAP_AS_OF=
GRAP_SOURCE_URL=
